# ==========================================
# SIGTRAZ - Environment Configuration
# ==========================================
# Copiar este archivo a .env.production y completar con tus valores

# DATABASE CONFIGURATION
# ==========================================
DB_HOST=db
DB_PORT=5432
DB_USER=sigtraz
DB_PASSWORD=sigtraz123
DB_DATABASE=sigtraz

# BACKEND CONFIGURATION
# ==========================================
PORT=4000
API_PORT=4000
NODE_ENV=production

# FRONTEND CONFIGURATION
# ==========================================
# URL base de la API backend (SIGTRAZ server)
VITE_API_URL=https://sigtraz.grupo-santacruz.com/api

# URL base publica de la app (para los QR de las etiquetas).
# Debe ser accesible desde un celular: dominio de produccion o la IP de la PC
# en la red local (ej. http://192.168.1.50:5173). Si se deja vacia se usa el
# origen actual del navegador.
VITE_PUBLIC_URL=https://sigtraz.grupo-santacruz.com

# SECURITY CONFIGURATION
# ==========================================
# IMPORTANTE: Cambiar estos valores en producción
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRES_IN=8h
SEED_PASSWORD=sigtraz123

# CORS CONFIGURATION
# ==========================================
# Orígenes permitidos para las solicitudes API
CORS_ORIGIN=https://sigtraz.grupo-santacruz.com

# WEB PORT
# ==========================================
WEB_PORT=3000

# CONTAINER REGISTRY (Opcional)
# ==========================================
# REGISTRY_URL=registry.example.com
# REGISTRY_USER=username
# REGISTRY_PASSWORD=password
