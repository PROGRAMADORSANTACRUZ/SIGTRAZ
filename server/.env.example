# Configuracion de conexion a PostgreSQL
# Copia este archivo como .env y ajusta los valores.

# Puerto de la API
PORT=4000

# Origen permitido para CORS (frontend Vite)
CORS_ORIGIN=http://localhost:5173

# Autenticacion (JWT)
JWT_SECRET=cambia-esta-clave-por-una-larga-y-secreta
JWT_EXPIRES_IN=8h
# Password por defecto asignada a los usuarios semilla en db:init
SEED_PASSWORD=sigtraz123

# SSO con la Suite Santa Cruz
# URL base del BACKEND de la suite (donde se canjea el ticket).
SUITE_URL=http://localhost:8000
# Debe ser IDENTICO al SSO_SHARED_SECRET de la suite.
SSO_SHARED_SECRET=

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_DATABASE=sigtraz
DB_USER=postgres
DB_PASSWORD=TuPasswordDePostgres

# Correo (Gmail) para envio de documentos desde la app
# SMTP_PASSWORD debe ser una "Contrasena de aplicacion" de Google (16 letras, sin espacios).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=veterinario.gruposantacruz@gmail.com
SMTP_PASSWORD=TuContrasenaDeAplicacion
SMTP_FROM=Agropecuaria Santacruz <veterinario.gruposantacruz@gmail.com>
